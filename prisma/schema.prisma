generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Town {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String   @default("#1e40af")
  contactEmail String?
  aboutText    String?
  heroImageUrl String?
  siteText     String   @default("")
  checkbookSettings String @default("")
  inviteCode      String   @default("")
  allowedDomains  String   @default("")
  accountCodeRules String   @default("")
  published       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploads          Upload[]
  budgetRows       BudgetRow[]
  columnMappings   ColumnMapping[]
  tooltips         Tooltip[]
  questions        ResidentQuestion[]
  supportingLinks  SupportingLink[]
  pdfDocuments     PdfDocument[]
  staffUsers       StaffUser[]
  staffInvites     StaffInvite[]
  capitalRequests  CapitalRequest[]
  faqEntries       FaqEntry[]
  checkbookBatches  CheckbookBatch[]
  checkbookVendors  CheckbookVendor[]
  checkbookPayments CheckbookPayment[]
}

model AdminUser {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  name              String
  emailVerified     Boolean  @default(false)
  verificationToken String?
  createdAt         DateTime @default(now())
  sessions          Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Tooltip {
  id     String @id @default(cuid())
  townId String
  town   Town   @relation(fields: [townId], references: [id], onDelete: Cascade)
  scope  String // "category" | "line-item"
  key    String // category name or lineItem identifier
  text   String

  @@unique([townId, scope, key])
}

model Upload {
  id           String   @id @default(cuid())
  townId       String
  town         Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  fileName     String
  fileType     String
  dataCategory String
  rowCount     Int      @default(0)
  status       String   @default("uploaded")
  rawHeaders   String
  createdAt    DateTime @default(now())
}

model ColumnMapping {
  id           String  @id @default(cuid())
  townId       String
  town         Town    @relation(fields: [townId], references: [id], onDelete: Cascade)
  dataCategory String
  sourceColumn String
  targetField  String
  confidence   Float   @default(0)
  confirmed    Boolean @default(false)

  @@unique([townId, dataCategory, sourceColumn])
}

model BudgetRow {
  id             String @id @default(cuid())
  townId         String
  town           Town   @relation(fields: [townId], references: [id], onDelete: Cascade)
  uploadId       String
  dataCategory   String

  fundCode       String?
  fundName       String?
  department     String?
  departmentCode String?
  functionArea   String?
  lineItem       String?
  objectCode     String?
  category1      String?
  category2      String?
  fiscalYear     String
  amount         Float
  amountType     String

  purpose        String?
  fundingSource  String?

  customLabel    String?
  customValue    String?

  createdAt      DateTime @default(now())

  @@index([townId, dataCategory])
  @@index([townId, dataCategory, fiscalYear])
  @@index([townId, fundCode])
}

model ResidentQuestion {
  id        String   @id @default(cuid())
  townId    String
  town      Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  name      String
  email     String
  message   String
  status    String   @default("new")
  reply     String?
  createdAt DateTime @default(now())

  @@index([townId, status])
}

model SupportingLink {
  id          String   @id @default(cuid())
  townId      String
  town        Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  title       String
  url         String
  description String?
  category    String   @default("other")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([townId])
}

model PdfDocument {
  id        String   @id @default(cuid())
  townId    String
  town      Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  fileName  String
  filePath  String
  fileSize  Int
  title     String?
  category  String   @default("other")
  createdAt DateTime @default(now())

  @@index([townId])
}

model StaffUser {
  id                String   @id @default(cuid())
  townId            String
  town              Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  email             String   @unique
  passwordHash      String
  name              String
  department        String?
  emailVerified     Boolean  @default(false)
  verificationToken String?
  resetToken        String?  @unique
  createdAt         DateTime @default(now())

  sessions        StaffSession[]
  capitalRequests CapitalRequest[]
}

model StaffInvite {
  id        String   @id @default(cuid())
  townId    String
  town      Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([townId])
}

model StaffSession {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      StaffUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model FaqEntry {
  id        String   @id @default(cuid())
  townId    String
  town      Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([townId])
}

model CapitalRequest {
  id            String    @id @default(cuid())
  townId        String
  town          Town      @relation(fields: [townId], references: [id], onDelete: Cascade)
  staffUserId   String
  staffUser     StaffUser @relation(fields: [staffUserId], references: [id])
  department    String
  purpose       String
  description   String?
  amount        Float
  fundingSource String?
  justification String?
  fiscalYear    String
  status        String    @default("submitted")
  adminNotes    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([townId, status])
  @@index([staffUserId])
}

// ── Open Checkbook ─────────────────────────────────────────────────────────
// Vendor payments from the ERP "Invoice History" extract, grouped by warrant.
// Only CheckbookPayment / CheckbookVendor.displayName are ever shown publicly.
// Anything sensitive (original vendor names, raw memos) lives in admin-only fields.

model CheckbookBatch {
  id             String   @id @default(cuid())
  townId         String
  town           Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  fileName       String
  fileHash       String
  uploadedBy     String?
  rowCount       Int      @default(0)
  newCount       Int      @default(0)
  duplicateCount Int      @default(0)
  changedCount   Int      @default(0)
  heldCount      Int      @default(0)
  excludedCount  Int      @default(0)
  flaggedCount   Int      @default(0)
  totalAmount    Float    @default(0)
  summary        String   @default("{}")
  createdAt      DateTime @default(now())

  payments CheckbookPayment[]

  @@index([townId, createdAt])
  @@index([townId, fileHash])
}

model CheckbookVendor {
  id            String   @id @default(cuid())
  townId        String
  town          Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  erpVendorId   String
  rawName       String   // ADMIN ONLY: name exactly as it appears in the ERP
  displayName   String   // what the public sees
  kind          String   @default("review") // "business" | "individual" | "review"
  suggestedKind String?  // heuristic hint for the reviewer
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments CheckbookPayment[]

  @@unique([townId, erpVendorId])
  @@index([townId, kind])
}

model CheckbookPayment {
  id          String   @id @default(cuid())
  townId      String
  town        Town     @relation(fields: [townId], references: [id], onDelete: Cascade)
  batchId     String
  batch       CheckbookBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      CheckbookVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  erpVendorId String
  naturalKey  String   // DOCUMENT|VOUCHER|ACCOUNT (+ #n if repeated) -- identity of a payment line
  contentHash String   // fingerprint of every field; detects changed lines
  fiscalYear  String
  period      Int?
  warrant     String?
  paymentType String   @default("payment") // "payment" | "credit" | "direct"
  amount      Float
  invoiceDate DateTime?
  invoiceNo   String?
  functionArea String?
  department  String?
  category    String?
  glAccount   String?
  memo        String?  // PUBLIC, sanitized
  status      String   @default("published") // "published" | "held" | "excluded"
  holdReason  String?
  flags       String   @default("[]")
  reviewed    Boolean  @default(false)
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  raw CheckbookPaymentRaw?

  @@unique([townId, naturalKey])
  @@index([townId, status, fiscalYear])
  @@index([townId, status, warrant])
  @@index([townId, vendorId])
  @@index([townId, invoiceNo])
  @@index([batchId])
}

// ADMIN ONLY. Never select from this table in any public query.
model CheckbookPaymentRaw {
  paymentId String   @id
  payment   CheckbookPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  memoRaw   String?
  invoiceRaw String?
  checkNo   String?
  document  String
  voucher   String?
  po        String?
}
